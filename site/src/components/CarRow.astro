---
import TierBadge from "./TierBadge.astro";
import { kr, krPerYear, confidenceLabel } from "../lib/data";
import type { RankedCar } from "../lib/data";
import { UI, type Lang } from "../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  car: RankedCar;
  rank: number;
  mode: "cost" | "value" | "running";
  lang?: Lang;
}
const { car, rank, mode, lang = "en" } = Astro.props;
const s = UI[lang].carRow;

const tier = mode === "cost" ? car.cost_tier : mode === "value" ? car.value_for_money_tier : car.running_cost_tier;

// primary = the number that actually decided this row's position; secondary
// = the other useful figure, shown smaller so two close candidates are easy
// to tell apart on the number that matters for this list.
const primaryLabel = mode === "cost" ? s.totalCost : mode === "value" ? s.valueScore : s.runningCost;
const primaryValue =
  mode === "cost" ? krPerYear(car.tco_per_year, lang)
  : mode === "value" ? s.pts(Math.round((car.value_for_money_score ?? 0) * 100))
  : krPerYear(car.running_cost_per_year, lang);

const secondaryLabel = mode === "value" ? s.costPerYear : mode === "running" ? s.totalCostPerYear : s.valueScore;
const secondaryValue =
  mode === "value" ? krPerYear(car.tco_per_year, lang)
  : mode === "running" ? (car.depreciation_available ? krPerYear(car.tco_per_year, lang) : null)
  : car.value_for_money_score !== null ? s.pts(Math.round(car.value_for_money_score * 100)) : null;

const confidenceDisplay = confidenceLabel(car.price_confidence, lang);

// Which quantity each score slot holds, so the mileage control (if present
// on the page) knows what to recompute and overwrite when the reader picks
// a different annual distance. Doesn't affect rendering when that control
// is absent.
const primaryField = mode === "cost" ? "tco" : mode === "value" ? "value" : "running";
const secondaryField = mode === "value" ? "tco" : mode === "running" ? "tco" : "value";

// Repairs and ownership tax are flat per year, unaffected by mileage; only
// fuel scales with distance and only resale erodes with it. The pipeline
// never emits an annual repair figure on its own, but it falls out of the
// running-cost total exactly, so it's derived here rather than duplicated
// in the pipeline output.
const annualRepair =
  car.running_cost_per_year - (car.median_annual_fuel_cost_dkk ?? 0) - (car.median_annual_ejerafgift_dkk ?? 0);
---

<a
  class="car-row"
  href={getRelativeLocaleUrl(lang, `/cars/${car.slug}/`)}
  data-hybrid={car.is_hybrid ? "1" : "0"}
  data-diesel={car.is_diesel_dominant ? "1" : "0"}
  data-segment={car.segment}
  data-entry={car.entry_price_dkk}
  data-resale={car.resale_price_dkk ?? ""}
  data-hold={car.hold_years ?? ""}
  data-dep={car.depreciation_available ? "1" : "0"}
  data-fuel={car.median_annual_fuel_cost_dkk ?? ""}
  data-ejer={car.median_annual_ejerafgift_dkk ?? ""}
  data-repair={annualRepair}
  data-eng={car.engagement_score ?? ""}
  data-name={`${car.makeDisplay} ${car.modelDisplay}`}
  data-band-years={car.band_years}
>
  <span class="rank num">{rank}</span>
  <TierBadge tier={tier} />
  <span class="name">
    <strong>{car.makeDisplay} {car.modelDisplay}</strong>
    <span class="sub">{car.band_years} &middot; {s.buyAround} {kr(car.entry_price_dkk)}</span>
  </span>
  {car.is_hybrid && (
    <span class="confidence-flag hybrid-flag" title={s.hybridTitle}>
      {s.hybridLabel}
    </span>
  )}
  {car.is_diesel_dominant && (
    <span class="confidence-flag" title={s.dieselTitle}>
      {s.dieselLabel}
    </span>
  )}
  {car.price_confidence !== "high" && (
    <span class="confidence-flag" title={s.confidenceTitle(confidenceDisplay)}>
      {confidenceDisplay} {s.confidenceSuffix}
    </span>
  )}
  <span class="scores">
    <span class="score-primary num" data-field={primaryField}>
      <span class="score-value">{primaryValue}</span>
      {mode !== "running" && !car.depreciation_available && <span class="asterisk" title={s.runningOnlyTitle}>*</span>}
    </span>
    <span class="score-label">{primaryLabel}</span>
    {secondaryValue && (
      <span class="score-secondary" data-field={secondaryField}>
        <span class="num score-value">{secondaryValue}</span> {secondaryLabel}
      </span>
    )}
  </span>
</a>

<style>
  .car-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .car-row:hover {
    background: var(--accent-soft);
  }
  .rank {
    width: 22px;
    color: var(--ink-faint);
    font-size: 0.9rem;
    text-align: right;
    flex-shrink: 0;
  }
  .name {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .name strong {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
  }
  .name .sub {
    font-size: 0.83rem;
    color: var(--ink-faint);
  }
  .confidence-flag {
    font-family: var(--font-data);
    font-size: 0.72rem;
    color: var(--ink-soft);
    background: var(--line);
    padding: 3px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .scores {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    white-space: nowrap;
    text-align: right;
    flex-shrink: 0;
  }
  .score-primary {
    font-weight: 700;
    font-size: 1rem;
  }
  .score-label {
    font-size: 0.7rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .score-secondary {
    font-size: 0.78rem;
    color: var(--ink-soft);
    margin-top: 2px;
  }
  .asterisk { color: var(--accent); }
  .hybrid-flag { color: var(--accent); background: var(--accent-soft); }

  @media (max-width: 480px) {
    .car-row {
      flex-wrap: wrap;
      row-gap: 8px;
    }
    .name {
      flex-basis: 120px;
    }
    .scores {
      flex-basis: 100%;
    }
  }
</style>

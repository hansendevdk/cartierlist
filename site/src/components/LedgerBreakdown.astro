---
// The site's signature element: every price claim resolves to this same
// itemized statement, so a reader learns to read it once and can then read
// any car on the site. Bar segment widths are proportional to their kroner
// share of total cost, not decorative.
import { kr, krPerYear } from "../lib/data";
import type { RankedCar } from "../lib/data";
import { UI, type Lang } from "../i18n";

interface Props {
  car: RankedCar;
  compact?: boolean;
  lang?: Lang;
}
const { car, compact = false, lang = "en" } = Astro.props;
const s = UI[lang].ledger;

const hasDep = car.depreciation_available;
const segments = hasDep
  ? [
      { label: s.valueLostDep, value: car.depreciation_dkk ?? 0, color: "var(--cost)" },
      { label: s.fuel, value: car.fuel_total_dkk ?? 0, color: "var(--cost-2)" },
      { label: s.ownershipTax, value: car.ejerafgift_total_dkk ?? 0, color: "var(--cost-3)" },
      { label: s.repairs, value: car.repair_total_dkk ?? 0, color: "var(--cost-4)" },
    ]
  : [
      { label: s.fuel, value: car.fuel_total_dkk ?? 0, color: "var(--cost-2)" },
      { label: s.ownershipTax, value: car.ejerafgift_total_dkk ?? 0, color: "var(--cost-3)" },
      { label: s.repairs, value: car.repair_total_dkk ?? 0, color: "var(--cost-4)" },
    ];
const total = segments.reduce((sum, x) => sum + x.value, 0);
---

<div class:list={["ledger", { compact }]}>
  {!hasDep && (
    <p class="ledger-note">
      {s.note}
    </p>
  )}

  <div class="ledger-bar" role="img" aria-label={s.breakdownAria(segments.map(seg => `${seg.label} ${kr(seg.value)}`).join(", "))}>
    {segments.map((seg) => (
      seg.value > 0 && (
        <div class="ledger-bar-segment" style={`flex-grow: ${Math.max(seg.value, 1)}; background: ${seg.color};`} />
      )
    ))}
  </div>

  <dl class="ledger-list">
    {hasDep && (
      <>
        <div class="ledger-row">
          <dt>{s.buyAt(car.band_years)}</dt>
          <dd class="num">{kr(car.entry_price_dkk)}</dd>
        </div>
        <div class="ledger-row credit">
          <dt>{s.sellLater(car.hold_years ?? "")}</dt>
          <dd class="num">+{kr(car.resale_price_dkk)}</dd>
        </div>
        <div class="ledger-row subtotal">
          <dt>{s.valueLost}</dt>
          <dd class="num">{kr(car.depreciation_dkk)}</dd>
        </div>
      </>
    )}
    <div class="ledger-row">
      <dt><span class="swatch" style="background: var(--cost-2)"></span>{s.fuel}{hasDep ? s.years(car.hold_years ?? "") : s.perYearSuffix}</dt>
      <dd class="num">{kr(car.fuel_total_dkk)}</dd>
    </div>
    <div class="ledger-row">
      <dt><span class="swatch" style="background: var(--cost-3)"></span>{s.ownershipTax}{hasDep ? s.years(car.hold_years ?? "") : s.perYearSuffix}</dt>
      <dd class="num">{kr(car.ejerafgift_total_dkk)}</dd>
    </div>
    <div class="ledger-row">
      <dt><span class="swatch" style="background: var(--cost-4)"></span>{s.repairs}{hasDep ? s.years(car.hold_years ?? "") : s.perYearSuffix}</dt>
      <dd class="num">{kr(car.repair_total_dkk)}</dd>
    </div>
    <div class="ledger-row total">
      <dt>{hasDep ? s.totalYears(car.hold_years ?? "") : s.totalPerYear}</dt>
      <dd class="num">{kr(hasDep ? car.tco_total_dkk : total)}</dd>
    </div>
    <div class="ledger-row per-year">
      <dt>{s.perYear}</dt>
      <dd class="num">{krPerYear(car.tco_per_year, lang)}</dd>
    </div>
  </dl>
</div>

<style>
  .ledger-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    background: var(--accent-soft);
    border-radius: var(--radius);
    padding: 10px 14px;
    margin-bottom: 14px;
  }
  .ledger-bar {
    display: flex;
    width: 100%;
    height: 14px;
    border-radius: 3px;
    overflow: hidden;
    background: var(--line);
    margin-bottom: 18px;
  }
  .ledger-bar-segment {
    height: 100%;
  }
  .ledger-list {
    margin: 0;
  }
  .ledger-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 0.95rem;
  }
  .ledger-row dt { color: var(--ink-soft); display: flex; align-items: center; gap: 8px; }
  .ledger-row dd { margin: 0; }
  .ledger-row.credit dd { color: var(--value); }
  .ledger-row.subtotal {
    border-bottom: 1px solid var(--line-strong);
    font-weight: 600;
  }
  .ledger-row.subtotal dt, .ledger-row.subtotal dd { color: var(--ink); }
  .ledger-row.total {
    border-bottom: none;
    border-top: 2px solid var(--ink);
    margin-top: 4px;
    padding-top: 10px;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .ledger-row.per-year {
    border-bottom: none;
    padding-top: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .ledger-row.per-year dt { color: var(--accent); }
  .swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    display: inline-block;
  }
  .compact .ledger-row { font-size: 0.85rem; padding: 5px 0; }
  .compact .ledger-bar { height: 10px; margin-bottom: 12px; }
</style>

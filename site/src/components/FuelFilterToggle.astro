---
// Client-side show/hide filter over CarRow elements already rendered in the
// page, not a new data fetch or a rebuild. Checked state is remembered in
// localStorage so a reader who says "hide diesel" doesn't have to say it
// again on the next page. localStorage keys are shared across locales on
// purpose: switching language shouldn't reset the filter.
import { UI, type Lang } from "../i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const s = UI[lang].fuelFilter;
const methodologyHref = getRelativeLocaleUrl(lang, "/methodology") + "#pricing";
---

<div class="fuel-filter">
  <span class="fuel-filter-label">{s.filterThisList}</span>
  <label>
    <input type="checkbox" id="hide-hybrid-toggle" />
    {s.hideHybrids}
  </label>
  <label>
    <input type="checkbox" id="hide-diesel-toggle" />
    {s.hideDiesel}
  </label>
  <span class="fuel-filter-note">
    {s.note} <a href={methodologyHref}>{s.noteLink}</a>
  </span>
</div>

<style>
  .fuel-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin: 18px 0 8px;
    padding: 10px 14px;
    background: var(--accent-soft);
    border-radius: var(--radius);
    font-size: 0.88rem;
  }
  .fuel-filter-label {
    font-family: var(--font-data);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }
  .fuel-filter label {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    cursor: pointer;
  }
  .fuel-filter input {
    accent-color: var(--accent);
    cursor: pointer;
  }
  .fuel-filter-note {
    color: var(--ink-faint);
    font-size: 0.78rem;
    flex-basis: 100%;
  }
  .fuel-filter-note a {
    color: var(--ink-soft);
  }
</style>

<script>
  import { applyRowVisibility } from "../lib/rowFilters";

  function initToggle(id: string, storageKey: string) {
    const box = document.getElementById(id) as HTMLInputElement | null;
    if (!box) return;
    box.checked = localStorage.getItem(storageKey) === "1";
    box.addEventListener("change", () => {
      localStorage.setItem(storageKey, box.checked ? "1" : "0");
      applyRowVisibility();
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    initToggle("hide-hybrid-toggle", "hideHybrid");
    initToggle("hide-diesel-toggle", "hideDiesel");
    applyRowVisibility();
  });
</script>

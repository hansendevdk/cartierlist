---
import Layout from "../../../layouts/Layout.astro";
import LedgerBreakdown from "../../../components/LedgerBreakdown.astro";
import TierBadge from "../../../components/TierBadge.astro";
import { rankings, unpriced, bracketLabel, getSiblingAges, reliabilityNote, kr, pct, km } from "../../../lib/data";
import type { RankedCar } from "../../../lib/data";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = "da" as const;

export function getStaticPaths() {
  const priced = rankings.map((car) => ({ params: { slug: car.slug }, props: { car, priced: true } }));
  const noPriced = unpriced.map((car) => ({ params: { slug: car.slug }, props: { car, priced: false } }));
  return [...priced, ...noPriced];
}

const { car, priced } = Astro.props as { car: any; priced: boolean };

const siblingAges = getSiblingAges(car, priced);
---

<Layout
  title={`${car.makeDisplay} ${car.modelDisplay}, ${car.band_years}`}
  description={`Ejeromkostninger, pålidelighed og reparationsdata for en ${car.makeDisplay} ${car.modelDisplay} første gang indregistreret ${car.band_years}.`}
  lang={lang}
  path={`/cars/${car.slug}/`}
>
  <div class="container">
    <p class="eyebrow">
      {priced ? <a href={getRelativeLocaleUrl(lang, `/brackets/${car.price_bracket_id}/`)}>{bracketLabel(car.price_bracket_id, lang)}</a> : "Intet prisestimat"}
      {" / "}{car.band_years}
    </p>
    <div class="title-row">
      <h1>{car.makeDisplay} {car.modelDisplay}</h1>
      {priced && (
        <div class="badges">
          <div class="badge-item"><TierBadge tier={car.cost_tier} /><span>pris</span></div>
          <div class="badge-item"><TierBadge tier={car.value_for_money_tier} /><span>værdi</span></div>
        </div>
      )}
    </div>
    {(car.is_hybrid || car.is_diesel_dominant) && (
      <p class="fuel-tags">
        {car.is_hybrid && (
          <span class="fuel-tag" title="Variantnavnet nævner hybrid eller plug-in.">hybrid</span>
        )}
        {car.is_diesel_dominant && (
          <span class="fuel-tag" title="Over halvdelen af de registrerede biler bag denne række er diesel.">diesel</span>
        )}
      </p>
    )}
    <p class="sub">Første gang indregistreret {car.band_years}, omkring {car.approx_age_years} år gammel i dag. Baseret på {car.dk_vehicle_count?.toLocaleString("da-DK")} af dem indregistreret i Danmark.</p>

    {priced ? (
      <div class="card ledger-card">
        <LedgerBreakdown car={car} lang={lang} />
      </div>
    ) : (
      <div class="card no-price-card">
        <p class="eyebrow">Hvorfor der ikke er en pris her</p>
        <p>
          {car.makeDisplay} sælges ikke i store nok antal på det brugtbilmarked, vi bruger til
          at estimere priser (det polske brugtmarked, brugt som afgiftsfri stedfortræder for en
          bils værdi, se <a href={getRelativeLocaleUrl(lang, "/methodology") + "#pricing"}>metodesiden</a>). I stedet for at gætte
          viser vi det, vi ved: pålidelighed og driftsomkostninger, uden pris og uden placering.
        </p>
      </div>
    )}

    <div class="stat-grid">
      <div class="stat card">
        <p class="eyebrow">Pålidelighed</p>
        {car.standardized_pass_rate !== null ? (
          <>
            <p class="stat-value">{pct(car.standardized_pass_rate)}</p>
            <p class="stat-detail">bestod sit britiske MOT-syn i første forsøg, {reliabilityNote(car.standardized_pass_rate, lang)}. Justeret for hvor langt disse biler typisk køres.</p>
          </>
        ) : (
          <p class="stat-detail">For få registrerede MOT-syn til at måle det her pålideligt.</p>
        )}
      </div>
      <div class="stat card">
        <p class="eyebrow">Reparationsbelastning</p>
        {car.repair_burden_index !== null ? (
          <>
            <p class="stat-value">{Number(car.repair_burden_index).toFixed(2)}</p>
            <p class="stat-detail">et indeks over hvor tit ting går i stykker, og hvor dyre {car.makeDisplay}-reservedele plejer at være. Omkring 0,7 til 1,0 er typisk, højere betyder mere.</p>
          </>
        ) : (
          <p class="stat-detail">For lidt data til at estimere det her.</p>
        )}
      </div>
      <div class="stat card">
        <p class="eyebrow">Brændstofudgift</p>
        <p class="stat-value">{kr(car.median_annual_fuel_cost_dkk)}<span class="stat-unit">/år</span></p>
        <p class="stat-detail">ved 15.000 km om året og aktuelle danske pumpepriser.</p>
      </div>
      <div class="stat card">
        <p class="eyebrow">Grøn ejerafgift</p>
        <p class="stat-value">{kr(car.median_annual_ejerafgift_dkk)}<span class="stat-unit">/år</span></p>
        <p class="stat-detail">grøn ejerafgift, ud fra bilens forbrugs- eller CO2-tal.</p>
      </div>
    </div>

    {priced && (
      <div class="confidence card">
        <p class="eyebrow">Hvor sikre er vi på prisen?</p>
        <p>
          <strong class="cap">{car.price_confidence === "low" ? "lav" : car.price_confidence === "medium" ? "middel" : "høj"}</strong> sikkerhed.
          Baseret på {car.price_n_listings} sammenlignelige udenlandske annoncer
          {car.price_pooled_at_brand ? ", samlet på tværs af hele mærket frem for denne bestemte model (for få annoncer betød, at vi måtte låne mærkets samlede prismønster)" : ""}.
          Det endelige tal er justeret med en korrektionsfaktor på {Number(car.price_calibration_factor).toFixed(2)}x,
          fundet ved at holde en stikprøve af danske udbudspriser op mod vores rå estimat.
          Læs mere på <a href={getRelativeLocaleUrl(lang, "/methodology") + "#pricing"}>metodesiden</a>.
        </p>
      </div>
    )}

    {siblingAges.length > 0 && (
      <div class="siblings">
        <h2>Denne model i andre aldre</h2>
        <div class="sibling-grid">
          {siblingAges.map((s) => (
            <a class="sibling card" href={getRelativeLocaleUrl(lang, `/cars/${s.slug}/`)}>
              <span class="sibling-band">{s.band_years}</span>
              {"entry_price_dkk" in s ? <span class="num">{kr((s as RankedCar).entry_price_dkk)}</span> : <span class="sibling-no-price">ingen prisdata</span>}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  .eyebrow a { color: var(--ink-faint); }
  .eyebrow a:hover { color: var(--accent); }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .badges { display: flex; gap: 18px; }
  .badge-item { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .badge-item span { font-size: 0.7rem; color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.04em; }
  .fuel-tags { display: flex; gap: 8px; margin: 4px 0 8px; }
  .fuel-tag {
    font-family: var(--font-data);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    background: var(--accent-soft);
    padding: 3px 8px;
    border-radius: 3px;
  }
  .sub { color: var(--ink-faint); font-size: 0.95rem; margin-top: -0.4em; }

  .ledger-card, .no-price-card { padding: 24px 26px; margin: 28px 0 40px; }
  .no-price-card p { margin: 0; color: var(--ink-soft); }
  .no-price-card .eyebrow { margin-bottom: 0.6em; }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .stat { padding: 18px 20px; }
  .stat-value { font-family: var(--font-display); font-size: 1.7rem; font-weight: 800; margin: 0 0 6px; }
  .stat-unit { font-family: var(--font-body); font-size: 0.95rem; font-weight: 500; color: var(--ink-faint); }
  .stat-detail { font-size: 0.85rem; color: var(--ink-faint); margin: 0; }

  .confidence { padding: 18px 22px; margin-bottom: 40px; }
  .confidence p { margin: 0; color: var(--ink-soft); }
  .cap { text-transform: capitalize; color: var(--accent); }

  .siblings { padding-bottom: 64px; }
  .siblings h2 { font-size: 1.5rem; }
  .sibling-grid { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 12px; }
  .sibling {
    padding: 12px 18px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 130px;
  }
  .sibling:hover { border-color: var(--accent); }
  .sibling-band { font-size: 0.8rem; color: var(--ink-faint); }
  .sibling-no-price { font-size: 0.85rem; color: var(--ink-faint); font-style: italic; }
</style>

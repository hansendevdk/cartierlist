---
import Layout from "../../layouts/Layout.astro";
import LedgerBreakdown from "../../components/LedgerBreakdown.astro";
import { rankings, methodology, getBracketStats } from "../../lib/data";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = "da" as const;
const heroCar = rankings.find((r) => r.slug === "peugeot-108--band1")!;

const fact = (label: string) => methodology.find((m) => m.fact.startsWith(label))?.value ?? "";
const scopedFleet = fact("Danish vehicles in scope");
const motTests = fact("Eligible DVSA MOT tests");
const crosswalkFact = fact("Crosswalked models");

function fmt(n: string | number) {
  return Number(n).toLocaleString("da-DK").replace(/,/g, ".");
}

const { bracketStats, cheapestBracket } = getBracketStats(lang);
---

<Layout
  title="Bedste brugte biler i Danmark, efter budget"
  description="En rangering af brugte biler solgt i Danmark efter hvad de koster at eje, bygget på køretøjsregister- og synsdata og sorteret i prisklasser."
  lang={lang}
  path="/"
>
  <section class="hero">
    <div class="container-wide hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">En bil koster mere end sin pris</p>
        <h1>Hvad koster en brugt bil dig, ikke bare at købe, men at eje?</h1>
        <p class="hero-lede">
          Alle priser på siden er lagt sammen som på en kvittering: hvad du betaler, minus hvad
          du får igen ved salg, plus brændstof, afgift og reparationer undervejs. Her er et
          eksempel med vores tal for en {heroCar.makeDisplay} {heroCar.modelDisplay}{" "}
          første gang indregistreret {heroCar.band_years}.
        </p>
        <a class="cta" href="#brackets">Find dit budget &darr;</a>
      </div>
      <div class="hero-example card">
        <p class="eyebrow">{heroCar.makeDisplay} {heroCar.modelDisplay}, {heroCar.band_years}</p>
        <LedgerBreakdown car={heroCar} lang={lang} />
        <a class="hero-example-link" href={getRelativeLocaleUrl(lang, `/cars/${heroCar.slug}/`)}>Se hele regnskabet &rarr;</a>
      </div>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <p class="eyebrow">Sådan er vi nået frem til det</p>
      <h2>Vi har lavet to store offentlige datasæt om til ét tal per bil</h2>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <div>
            <h3>Startet med {fmt(scopedFleet)} danske biler</h3>
            <p>
              Vi hentede Motorregistrets offentlige køretøjsdata, beholdt benzin-, diesel- og
              hybridpersonbiler første gang indregistreret mellem 2010 og 2022, og koblede{" "}
              {fmt(crosswalkFact.toString().split(" ")[0])} modeller sammen med britiske
              MOT-synsdata for at måle, hvor tit de går i stykker.
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <h3>{fmt(motTests)} MOT-syn gennemgået for fejlmønstre</h3>
            <p>
              Pålideligheden kommer fra det britiske offentlige MOT-synsarkiv, justeret så en
              bil der er kørt meget, ikke bliver sammenlignet urimeligt med en jævnaldrende der
              er kørt lidt.
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <h3>Prissat hver bil og holdt den op mod det danske marked</h3>
            <p>
              Vi lavede et prisestimat for hver model i fire aldre og holdt det op mod
              udbudspriser, vi selv slog op på danske bilsider, og korrigerede for forskellen.{" "}
              <a href={getRelativeLocaleUrl(lang, "/methodology") + "#pricing"}>Hele prismetoden</a>
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">4</span>
          <div>
            <h3>Hvad du ender med at betale, når brændstof, afgift og reparationer er lagt sammen</h3>
            <p>
              Brændstof, grøn ejerafgift og et estimat for reparationer lægges sammen med
              gensalgsværdien til én samlet ejeromkostning per bil. Bilerne er delt i fem
              prisklasser og rangeret inden for hver, så du kun sammenligner biler, du kan betale.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="finding">
    <div class="container">
      <div class="finding-card card">
        <p class="eyebrow">Hvad tallene siger</p>
        {cheapestBracket && (
          <p class="finding-text">
            Blandt de bedst placerede biler i hver prisklasse er <strong>{cheapestBracket.label}</strong>{" "}
            billigst at eje per år, omkring <strong class="num">{fmt(Math.round(cheapestBracket.median!))} kr</strong>{" "}
            om året. Billig kan betyde billig at købe. Her betyder det også billig at beholde.
          </p>
        )}
      </div>
    </div>
  </section>

  <section id="brackets" class="brackets">
    <div class="container">
      <p class="eyebrow">Find dit budget</p>
      <h2>Vælg en prisklasse</h2>
      <p class="section-lede">Hver prisklasse rangerer de biler, du kan købe for pengene, med bedste værdi først.</p>
    </div>
    <div class="container-wide bracket-grid">
      {bracketStats.map((b) => (
        <a class="bracket-card card" href={getRelativeLocaleUrl(lang, `/brackets/${b.id}/`)}>
          <span class="bracket-label">{b.label}</span>
          <span class="bracket-count num">{b.count} biler rangeret</span>
          {b.median && <span class="bracket-median">fra omkring <strong class="num">{fmt(Math.round(b.median))} kr</strong>/år at eje</span>}
        </a>
      ))}
    </div>
  </section>

  <section class="running-cost-callout">
    <div class="container">
      <div class="card callout-card">
        <p class="eyebrow">Eller se bort fra prisen</p>
        <p>
          Nogle biler koster mere at købe, men betaler noget af det tilbage hvert år på
          brændstof og afgift.{" "}
          <a href={getRelativeLocaleUrl(lang, "/running-costs/")}>Se alle biler rangeret alene efter driftsomkostninger</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .hero-lede {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .cta {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--font-data);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }
  .hero-example {
    padding: 22px 24px;
  }
  .hero-example-link {
    display: block;
    margin-top: 14px;
    font-size: 0.9rem;
    text-align: right;
  }

  .process { padding: 64px 0; }
  .steps { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-direction: column; gap: 28px; }
  .steps li { display: flex; gap: 20px; }
  .step-num {
    font-family: var(--font-data);
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
  }
  .steps h3 { font-size: 1.3rem; margin-bottom: 0.3em; }
  .steps p { color: var(--ink-soft); margin: 0; }
  .steps p a { white-space: nowrap; }

  .finding { padding: 8px 0 56px; }
  .finding-card { padding: 26px 28px; border-left: 4px solid var(--accent); }
  .finding-text { font-size: 1.15rem; margin: 0; color: var(--ink); }
  .finding-text strong { color: var(--accent); }

  .brackets { padding: 8px 0 40px; }
  .running-cost-callout { padding-bottom: 72px; }
  .callout-card { padding: 18px 22px; }
  .callout-card p { margin: 0; color: var(--ink-soft); }
  .callout-card .eyebrow { margin-bottom: 0.4em; }
  .section-lede { color: var(--ink-soft); max-width: 60ch; }
  .bracket-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .bracket-card {
    padding: 20px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.15s ease;
  }
  .bracket-card:hover { border-color: var(--accent); }
  .bracket-label { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; }
  .bracket-count { color: var(--ink-faint); font-size: 0.85rem; }
  .bracket-median { font-size: 0.88rem; color: var(--ink-soft); }
  .bracket-median strong { color: var(--value); }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

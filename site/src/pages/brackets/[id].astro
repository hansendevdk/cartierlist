---
import Layout from "../../layouts/Layout.astro";
import CarRow from "../../components/CarRow.astro";
import BracketDelta from "../../components/BracketDelta.astro";
import FuelFilterToggle from "../../components/FuelFilterToggle.astro";
import SegmentFilterToggle from "../../components/SegmentFilterToggle.astro";
import MileageControl from "../../components/MileageControl.astro";
import { BRACKET_IDS, bracketLabel, bandLabel, getBracketLists } from "../../lib/data";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = "en" as const;

export function getStaticPaths() {
  return BRACKET_IDS.map((id) => ({ params: { id }, props: { bracketId: id } }));
}

const { bracketId } = Astro.props;
const label = bracketLabel(bracketId, lang);
const { cars, byCost, byValue, bandsPresent, hasRunningCostOnly } = getBracketLists(bracketId);
---

<Layout
  title={`Best value cars, ${label}`}
  description={`Used cars in Denmark for around ${label}, ranked by total cost of ownership.`}
  lang={lang}
  path={`/brackets/${bracketId}/`}
>
  <div class="container-wide">
    <p class="eyebrow"><a href={getRelativeLocaleUrl(lang, "/")}>All budgets</a> / Price bracket</p>
    <h1>{label}</h1>
    <p class="lede">
      {cars.length} cars in our data sell for about this much, across ages{" "}
      {bandsPresent.map((b) => bandLabel(b, lang)).join(", ")}.
      Ranked by total cost to own, not just the price tag.
    </p>

    {hasRunningCostOnly && (
      <p class="note">
        The <span class="asterisk">*</span> marks cars old enough that we have no later resale
        price to compare against, so their number is running costs per year only. See the{" "}
        <a href={getRelativeLocaleUrl(lang, "/methodology")}>methodology page</a> for the full picture.
      </p>
    )}

    <BracketDelta bracketId={bracketId} lang={lang} />

    <FuelFilterToggle lang={lang} />
    <SegmentFilterToggle lang={lang} />
    <MileageControl lang={lang} />

    <div class="lists">
      <div class="list-block">
        <h2>Cheapest to own</h2>
        <p class="list-sub">Ranked purely on money: purchase minus resale, plus fuel, tax and repairs, per year.</p>
        <div class="card list-card" data-list-mode="cost">
          {byCost.map((c, i) => <CarRow car={c} rank={i + 1} mode="cost" lang={lang} />)}
        </div>
      </div>

      <div class="list-block">
        <h2>Most car for the money</h2>
        <p class="list-sub">
          Half cost, half how engaging the car is to drive (power-to-weight, cylinders, kerb
          weight), an equal, disclosed blend, not hidden in the score.
        </p>
        <div class="card list-card" data-list-mode="value">
          {byValue.map((c, i) => <CarRow car={c} rank={i + 1} mode="value" lang={lang} />)}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .eyebrow a { color: var(--ink-faint); text-decoration: none; }
  .eyebrow a:hover { color: var(--accent); }
  .lede { max-width: 68ch; color: var(--ink-soft); font-size: 1.05rem; }
  .note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    background: var(--accent-soft);
    border-radius: var(--radius);
    padding: 10px 14px;
    max-width: 68ch;
  }
  .asterisk { color: var(--accent); font-weight: 700; }
  .lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto 1fr;
    grid-auto-flow: column;
    column-gap: 32px;
    margin-top: 32px;
    padding-bottom: 72px;
  }
  /* display: contents unwraps each list-block so its h2/intro/card become
     direct grid items -- grid-template-rows names exactly 3 rows so
     grid-auto-flow: column knows where to wrap into the second column,
     putting one block's three pieces in row 1/2/3 of column 1 and the
     other's in column 2. Without an explicit row count here, column
     auto-flow has no wrap point and every item's height gets counted into
     one collapsed row instead of three, which is what caused the
     misalignment in the first place. Row 2 (the intro paragraph) sizes to
     whichever is taller and both cards in row 3 start at the same height,
     however many lines either intro wraps to. */
  .list-block { display: contents; }
  .list-block h2 { font-size: 1.5rem; margin-bottom: 0.2em; }
  .list-sub { color: var(--ink-faint); font-size: 0.88rem; margin-bottom: 14px; max-width: 46ch; }
  .list-card { padding: 4px 0; max-height: 720px; overflow-y: auto; }
  @media (max-width: 900px) {
    .lists { grid-template-columns: 1fr; grid-auto-flow: row; }
    .list-block { display: block; margin-bottom: 32px; }
  }
</style>

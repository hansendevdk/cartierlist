---
import Layout from "../layouts/Layout.astro";
import LedgerBreakdown from "../components/LedgerBreakdown.astro";
import { rankings, RANK_ELIGIBLE, methodology, coverage, BRACKETS, carsInBracket } from "../lib/data";

const heroCar = rankings.find((r) => r.slug === "peugeot-108--band1")!;

const fact = (label: string) => methodology.find((m) => m.fact.startsWith(label))?.value ?? "";
const scopedFleet = fact("Danish vehicles in scope");
const motTests = fact("Eligible DVSA MOT tests");
const crosswalkFact = fact("Crosswalked models");

function fmt(n: string | number) {
  return Number(n).toLocaleString("da-DK").replace(/,/g, ".");
}

const bracketStats = BRACKETS.map((b) => {
  const cars = carsInBracket(b.id);
  const sTier = cars.filter((c) => c.cost_tier === "S" || c.cost_tier === "A");
  const median = sTier.length
    ? sTier.map((c) => c.tco_per_year).sort((a, b2) => a - b2)[Math.floor(sTier.length / 2)]
    : null;
  return { ...b, count: cars.length, median };
});
const cheapestBracket = bracketStats
  .filter((b) => b.median !== null)
  .sort((a, b) => (a.median! - b.median!))[0];
---

<Layout
  title="Best value used cars in Denmark, by budget"
  description="A cost-of-ownership ranking of used cars sold in Denmark, built from vehicle registration and MOT test data, sorted into price brackets."
>
  <section class="hero">
    <div class="container-wide hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">A car costs more than its price tag</p>
        <h1>What will a used car actually cost you, not just to buy, but to own?</h1>
        <p class="hero-lede">
          Every price on this site adds up the same way a real receipt would: what you pay,
          minus what you get back when you sell, plus fuel, tax and repairs in between.
          Here is one real example, using our data for a {heroCar.makeDisplay} {heroCar.modelDisplay}{" "}
          first registered {heroCar.band_years}.
        </p>
        <a class="cta" href="#brackets">Find your budget &darr;</a>
      </div>
      <div class="hero-example card">
        <p class="eyebrow">{heroCar.makeDisplay} {heroCar.modelDisplay}, {heroCar.band_years}</p>
        <LedgerBreakdown car={heroCar} />
        <a class="hero-example-link" href={`/cars/${heroCar.slug}/`}>See the full breakdown &rarr;</a>
      </div>
    </div>
  </section>

  <section class="process">
    <div class="container">
      <p class="eyebrow">How we got here</p>
      <h2>We turned two large public datasets into one number per car</h2>
      <ol class="steps">
        <li>
          <span class="step-num">1</span>
          <div>
            <h3>Started from {fmt(scopedFleet)} real Danish cars</h3>
            <p>
              We pulled the Danish Motor Registry's public vehicle data, kept petrol, diesel
              and hybrid passenger cars first registered between 2010 and 2022, and matched{" "}
              {fmt(crosswalkFact.toString().split(" ")[0])} models against UK MOT test records
              to measure how often each one actually breaks down.
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <h3>Checked {fmt(motTests)} MOT tests for real failure patterns</h3>
            <p>
              Reliability comes from the UK's public MOT test archive, adjusted so a
              heavily-driven car isn't unfairly compared to a lightly-driven one of the same age.
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <h3>Priced each car and checked it against the real Danish market</h3>
            <p>
              We built a price estimate for each model at four different ages, then checked it
              against real asking prices we looked up on Danish listing sites by hand and
              corrected for the gap.{" "}
              <a href="/methodology#pricing">Full pricing method &rarr;</a>
            </p>
          </div>
        </li>
        <li>
          <span class="step-num">4</span>
          <div>
            <h3>Added up fuel, tax and repairs, sorted by what you'd actually pay</h3>
            <p>
              Fuel cost, Danish ownership tax and an estimated repair cost combine with resale
              value to give one total cost of ownership per car. Cars are grouped into five price
              brackets and ranked inside each one, so you're only ever comparing cars you could
              actually afford.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="finding">
    <div class="container">
      <div class="finding-card card">
        <p class="eyebrow">What the numbers say</p>
        {cheapestBracket && (
          <p class="finding-text">
            Among the best-ranked cars in each bracket, <strong>{cheapestBracket.label}</strong>{" "}
            has the lowest cost per year to own, about <strong class="num">{fmt(Math.round(cheapestBracket.median!))} kr</strong>{" "}
            a year. Cheap does not just mean cheap to buy, it can mean cheap to keep.
          </p>
        )}
      </div>
    </div>
  </section>

  <section id="brackets" class="brackets">
    <div class="container">
      <p class="eyebrow">Find your budget</p>
      <h2>Pick a price bracket</h2>
      <p class="section-lede">Each bracket ranks cars you could actually buy for that budget, best value first.</p>
    </div>
    <div class="container-wide bracket-grid">
      {bracketStats.map((b) => (
        <a class="bracket-card card" href={`/brackets/${b.id}/`}>
          <span class="bracket-label">{b.label}</span>
          <span class="bracket-count num">{b.count} cars ranked</span>
          {b.median && <span class="bracket-median">from about <strong class="num">{fmt(Math.round(b.median))} kr</strong>/year to own</span>}
        </a>
      ))}
    </div>
  </section>

  <section class="running-cost-callout">
    <div class="container">
      <div class="card callout-card">
        <p class="eyebrow">Or ignore the price tag</p>
        <p>
          Some cars cost more to buy but pay part of it back every year in fuel and tax.{" "}
          <a href="/running-costs/">See every car ranked by running cost alone &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .hero-lede {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }
  .cta {
    display: inline-block;
    margin-top: 8px;
    font-family: var(--font-data);
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }
  .hero-example {
    padding: 22px 24px;
  }
  .hero-example-link {
    display: block;
    margin-top: 14px;
    font-size: 0.9rem;
    text-align: right;
  }

  .process { padding: 64px 0; }
  .steps { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-direction: column; gap: 28px; }
  .steps li { display: flex; gap: 20px; }
  .step-num {
    font-family: var(--font-data);
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
  }
  .steps h3 { font-size: 1.05rem; margin-bottom: 0.3em; }
  .steps p { color: var(--ink-soft); margin: 0; }
  .steps p a { white-space: nowrap; }

  .finding { padding: 8px 0 56px; }
  .finding-card { padding: 26px 28px; border-left: 4px solid var(--accent); }
  .finding-text { font-size: 1.15rem; margin: 0; color: var(--ink); }
  .finding-text strong { color: var(--accent); }

  .brackets { padding: 8px 0 40px; }
  .running-cost-callout { padding-bottom: 72px; }
  .callout-card { padding: 18px 22px; }
  .callout-card p { margin: 0; color: var(--ink-soft); }
  .callout-card .eyebrow { margin-bottom: 0.4em; }
  .section-lede { color: var(--ink-soft); max-width: 60ch; }
  .bracket-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .bracket-card {
    padding: 20px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.15s ease;
  }
  .bracket-card:hover { border-color: var(--accent); }
  .bracket-label { font-family: var(--font-display); font-weight: 800; font-size: 1.15rem; }
  .bracket-count { color: var(--ink-faint); font-size: 0.85rem; }
  .bracket-median { font-size: 0.88rem; color: var(--ink-soft); }
  .bracket-median strong { color: var(--value); }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
